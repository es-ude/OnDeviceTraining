# Scale-access gate allow-list (tools/check-scale-access.sh).
# Format: path<TAB>substring of the offending line<TAB>justification.
# Only ownership of the scales ARRAY (allocate / free / hand over / borrow) and
# verbatim whole-config byte copies of already-stored values belong here; no
# entry reads or writes a scale value.
src/tensor/Quantization.c	qC->scales = reserveMemory(numGroups * sizeof(*qC->scales));	init: allocates the scales array (SYM and ASYM init); every element is then written with odtScaleStore(ODT_SCALE_ONE)
src/serial/Deserialize.c	freeReservedMemory(symQC->scales);	ownership: frees the skeleton's scales array before reallocating it to the file's numGroups
src/serial/Deserialize.c	symQC->scales = reserveMemory(shape.numGroups * sizeof(*symQC->scales));	init: allocates the scales array for the file's numGroups; every element is then written with odtScaleStore
src/serial/Deserialize.c	freeReservedMemory(asymQC->scales);	ownership: ASYM twin of the SYM free above
src/serial/Deserialize.c	asymQC->scales = reserveMemory(shape.numGroups * sizeof(*asymQC->scales));	init: ASYM twin of the SYM allocation above; elements written with odtScaleStore
src/serial/Deserialize.c	freeReservedMemory(header->qConfigStorage.sym.scales);	ownership: frees the header skeleton's scales array
src/serial/Deserialize.c	header->qConfigStorage.sym.scales = NULL;	ownership: clears the freed pointer
src/serial/Deserialize.c	freeReservedMemory(header->qConfigStorage.asym.scales);	ownership: ASYM twin of the free above
src/serial/Deserialize.c	header->qConfigStorage.asym.scales = NULL;	ownership: ASYM twin of the clear above
src/userApi/tensor/TensorApi.c	odtScale_t *likeScales = reserveMemory(	init: getQLike's grouped clone allocates its own scales array, filled by copyCanonScales
src/userApi/tensor/TensorApi.c	likeAsymQC->scales = likeScales;	ownership: hands the freshly copied array to the ASYM clone
src/userApi/tensor/TensorApi.c	likeSymQC->scales = likeScales;	ownership: hands the freshly copied array to the SYM clone
src/userApi/tensor/TensorApi.c	freeReservedMemory(symQC->scales);	ownership: freeQuantization frees the SYM scales array
src/userApi/tensor/TensorApi.c	freeReservedMemory(asymQC->scales);	ownership: freeQuantization frees the ASYM scales array
src/userApi/LayerQuant.c	memcpy(dst->qConfig, src->qConfig, cfgSize);	whole-config copy: deepCopyQuantization byte-copies the config (a stored odtScale_t is copied verbatim, no conversion); the SYM/ASYM arrays are then re-pointed below
src/userApi/LayerQuant.c	odtScale_t *scales = reserveMemory(srcQC->numGroups * sizeof(*scales));	init: the deep copy's own scales array, filled by copyCanonScales
src/userApi/LayerQuant.c	dstQC->scales = scales;	ownership: hands the deep copy its own array (replaces the aliased pointer the byte copy left)
src/tensor/Tensor.c	memcpy(dest->qConfig, src->qConfig, qConfigSize);	whole-config copy: copyQuantization's SYM_INT32 arm byte-copies the config (the stored odtScale_t verbatim); SYM/ASYM use copyCanonScales instead
src/arithmetic/include/SymGroupedWeight.h	*asymView = (symQConfig_t){.scales = qc->scales,	borrow: the grouped-ASYM view shares the ASYM config's scales array for the duration of one executeOp call; no value is read or written here
